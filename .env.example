# GEMINI_API_KEY: Optional server-side key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted application URL
APP_URL="MY_APP_URL"

# Supabase Configuration (Optional - falls back gracefully to persistent localStorage state when unset)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Web3Forms Access Key (Optional - can also be configured in /admin settings)
VITE_WEB3FORMS_ACCESS_KEY=""
